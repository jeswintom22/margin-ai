# Copy to .env.local and fill in. Read only by the server (app/api/ask); never exposed to the browser.

# Required: API key for an OpenAI-compatible chat completions provider.
LLM_API_KEY=

# Optional: provider base URL (default https://api.openai.com/v1).
# Any OpenAI-compatible endpoint works, e.g. OpenRouter, Groq, or a local Ollama (http://localhost:11434/v1).
LLM_BASE_URL=

# Gemini (Google's official OpenAI-compatibility endpoint, ai.google.dev/gemini-api/docs/openai):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a Gemini model id from that page, e.g. a current "flash" model>
#   LLM_VISION_MODEL=<optional; defaults to LLM_MODEL on Gemini, whose models accept image input>
#   LLM_API_KEY=<Gemini API key from Google AI Studio>

# Optional: model name (default gpt-4o-mini).
LLM_MODEL=

# Optional per-capability models (all fall back to LLM_MODEL when unset).
# LLM_VISION_MODEL is required for Read-handwriting image requests.
LLM_FAST_MODEL=
LLM_VISION_MODEL=
LLM_REASONING_MODEL=

# Optional: request timeout in milliseconds (default 30000).
LLM_TIMEOUT_MS=

ASK_LOCAL_RATE_LIMIT=10
ASK_LOCAL_RATE_WINDOW_MS=60000
ASK_EXTERNAL_RATE_LIMIT_ENABLED=false

# Dev/test only: deterministic mock provider, no API key needed. Ignored when NODE_ENV=production.
# LLM_MOCK=true
